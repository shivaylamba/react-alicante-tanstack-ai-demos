{
  "name": "tanstack-ai-lightning",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:live": "tsx scripts/live.ts",
    "start": "NODE_ENV=production tsx server/index.ts",
    "skillbox:start": "node scripts/skillbox-local.mjs start",
    "skillbox:stop": "node scripts/skillbox-local.mjs stop"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/public-sans": "5.3.0",
    "@hono/node-server": "1.19.17",
    "@tanstack/ai": "0.61.0",
    "@tanstack/ai-code-mode": "0.4.16",
    "@tanstack/ai-isolate-quickjs": "0.3.1",
    "@tanstack/ai-openai": "0.24.1",
    "@tanstack/ai-react": "0.29.1",
    "@tanstack/ai-skills": "0.1.11",
    "@tanstack/ai-vercel-gateway": "0.2.20",
    "hono": "4.13.8",
    "openai": "6.49.0",
    "prismjs": "1.30.0",
    "qrcode": "1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "24.12.0",
    "@types/prismjs": "1.26.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
